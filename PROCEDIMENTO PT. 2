algoritmo "semnome"
var
   x, Y : inteiro
Procedimento Soma(var A, B: inteiro)
Inicio
      A <- A + 1
      B <- B + 2
      EscrevaL("recebi o numero A", A)
      EscrevaL("recebi o numero de B", B)
      EscrevaL("a soma dos valores A e B e:", A + B)
FimProcedimento
inicio

      X <- 4
      Y <- 8
      Soma (X, Y)
      
      EscrevaL("o valor de X", X)
      EscrevaL("o valor de Y", Y)
fimalgoritmo
