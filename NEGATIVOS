algoritmo "semnome"
var
   N, C, TotN :inteiro
inicio

      Totn <- 0
      C <- 1

      repita
      escreva("digite um numero: ")
      leia(N)
      Se (N<0) entao
         totn <- Totn + 1
      fimse
      C <- C + 1
      
      ate( C > 5)
      escreva("foram digitador ", TotN, " negativos")
      

fimalgoritmo
