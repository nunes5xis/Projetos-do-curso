algoritmo "semnome"
var
   N : caractere
   C : inteiro
inicio

      escreva("digite seu nome: ")
      leia(N)

      EscrevaL("total de letrar: " , compr(N))
      EscrevaL("seu nome em maisculo ", maiusc(N))
      EscrevaL("seu nome em minusculo ", minusc(N))
      EscrevaL("a primeira letra do seu nome ", copia(N, 1,1))
      EscrevaL("a ultima letra do seu nome ", copia(Maiusc(N), compr(N), 1))
      EscrevaL("seu nome tem a letra A na posicao", pos("A", Maiusc(N)))
      EscrevaL("o codigo da letra A do seu nome e", Asc("A"))
      EscrevaL("a letra do codigo 65 e ", carac(65))
      
      Para C <- compr(N) ate 1 passo -1 faca
           escreva(copia(Maiusc(N), C, 1))
      FimPara
fimalgoritmo
