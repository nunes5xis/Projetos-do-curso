algoritmo "semnome"
var
   N : inteiro
Procedimento ParOuImpar(v : inteiro)
Inicio
   Se (V % 2 = 0) entao
      escreva (" seu numero é par")
   senao
      escreva("seu numero e impar")
   fimse
FimProcedimento
inicio

      Escreva("Digite um numero: ")
      leia(N)
      ParOuImpar(N)
      
fimalgoritmo
