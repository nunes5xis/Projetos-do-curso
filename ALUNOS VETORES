algoritmo "semnome"
var
   nome: vetor [1..4] de caractere
   n1 : vetor [1..4] de real
   n2: vetor [1..4] de real
   media : vetor [1..4] de real
   SM, MT : real
   i, total : inteiro
inicio
      para i <- 1 ate 4 faca
         escrevaL("ALUNO", i)
         escreva("Nome: ")
         leia(nome[i])
         escreva("primeira nota: ")
         leia(n1[i])
         escreva("segunda nota: ")
         leia(n2[i])
         media[i] <- (n1[i] + n2[i]) /2
         SM <- SM + Media[i]
      fimpara
      MT <- SM / 4
      LimpaTela
      Para i <- 1 ate 4 faca
      escrevaL(NOME [i]:15, MEDIA [i])
        Se(Media[i] > MT) entao
        Total <- Total + 1
      fimse
      fimpara
      escreva("temos ", total, " alunos acima da media e a media da turma e ", MT:4:1)
      
fimalgoritmo
