algoritmo "EXERCICIOAULA011"
var
   Sexo, resp : caractere
   idade, cabelo : inteiro
inicio

      REPITA

      escreva("QUAL O SEXO? [M/F]")
      leia(sexo)
      
      escreva("QUAL A IDADE? ")
      leia(idade)
      
      escrevaL("QUAL A COR DO CABELO")
      escreval ("[1] PRETO")
      escreval ("[2] CASTANHO")
      escreval ("[3] LOIRO")
      escreval ("[4] RUIVO")
      Leia (cabelo)
      escolha(cabelo)

            Caso 1
           cabelo <- 1
      caso 2
           cabelo <- 2
      caso 3
           cabelo <- 3
      Caso 4
           cabelo <- 4
      FimEscolha

                Se(Sexo = M) e (idade >18) entao
                


      escreva("QUER CONTINUAR? [S/N]")
      leia(resp)
      ate(resp = "N")
      LimpaTela
fimalgoritmo
