algoritmo "semnome"
var
   val : vetor [1..7] de inteiro
   i, totpar : inteiro
inicio
      totpar <- 0
      para i <- 1 ate 7 faca
           escreva("digite o", i, "o. valor: ")
           leia(val[i])
           se(val[i] % 2 = 0) entao
           totpar <- totpar + 1
      fimse
      fimpara
      
      para i <- 1 ate 7 faca
         Se (val[i] % 2 = 0) entao
         totpar <- totpar + 1
            escrevaL("o valor PAR na posição", i )
         fimse
      fimpara
      escrevaL("o total de pares foi", totpar)
fimalgoritmo
