algoritmo "contagem"
var
     valor, salto, contador : inteiro
inicio

      contador <- 0
      escreva("qual seu numero? ")
      leia(valor)
      escreva("qual o valor do salto? ")
      leia(salto)
        enquanto (contador <= valor ) faca
        EscrevaL(contador)
        contador <- contador + salto
        
        FimEnquanto
fimalgoritmo
