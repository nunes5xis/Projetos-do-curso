algoritmo "semnome"
var
   valores: vetor [1..3, 1..3] de inteiro
   l, c, TotPar: inteiro
   
inicio

      Totpar <- 0
      para l <- 1 ate 3 faca
           para c <- 1 ate 3 faca
                escreva("digite o valor da posicao[", l, ",", c ," ]" )
                leia(valores[l,c])
           fimpara
      fimpara

      Para l <- 1 ate 3 faca
           para c <- 1 ate 3 faca
                se(valores[l,c] % 2 = 0) entao
                  escreva("{", valores[l,c]: 2, "}")
                  TotPar <- TotPar + 1
                senao
                  escreva(valores[l,c]: 4)
                fimse
           fimpara
           EscrevaL()
      fimpara
      escreva("o total de numeros pares foi", TotPar, " valores pares")

fimalgoritmo
